# Database Configuration
DATABASE_URL=jdbc:postgresql://postgres:5432/mivoto
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=mySecretKeyForJWTTokenGenerationThatShouldBeVeryLongAndSecure123456789

# Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (for docker-compose)
POSTGRES_DB=mivoto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mivoto.com
PGADMIN_PASSWORD=admin

# Redis Commander
REDIS_COMMANDER_PORT=8082
